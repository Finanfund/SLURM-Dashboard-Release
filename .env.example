# Required. Choose a strong private value before starting the dashboard.
DASHBOARD_PASSWORD=change-this-password

# Required when using app.py/start.py directly. launch.sh can also read this.
DASHBOARD_PORT=9000

# Optional. Keep local-only unless you understand the network exposure.
DASHBOARD_HOST=127.0.0.1

# Optional. Defaults to the current user's home directory.
DASHBOARD_FILE_BROWSER_ROOT=/path/to/cluster/home

# Optional display name.
DASHBOARD_CLUSTER_NAME=SLURM HPC Cluster

# Optional Python/conda controls for launch.sh.
# DASHBOARD_PYTHON=/path/to/python
# DASHBOARD_CONDA_ENV=/path/to/env-or-env-name
# DASHBOARD_CONDA_BASE=/path/to/miniconda-or-miniforge
